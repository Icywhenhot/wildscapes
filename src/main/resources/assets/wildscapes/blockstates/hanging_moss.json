{
  "multipart": [
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "wildscapes:block/hanging_moss_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "wildscapes:block/hanging_moss_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "wildscapes:block/hanging_moss_side",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "wildscapes:block/hanging_moss_side",
        "y": 270
      }
    }
  ]
}